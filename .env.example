# ============================================
# AI Chat Hub - Environment Variables
# ============================================

# Your API Key from the Unified AI Hub / xgpt10 platform
# Format: ah_live_xxxxxxxxxxxx
API_HUB_KEY=ah_live_your_key_here

# Base URL of the Unified AI API (without trailing slash)
# Example: https://your-api-hub-domain.com
# Or if using the platform directly: leave as is and update after deployment
NEXT_PUBLIC_API_BASE_URL=https://your-api-hub-domain.com

# Optional: Default provider & model
NEXT_PUBLIC_DEFAULT_PROVIDER=gemini
NEXT_PUBLIC_DEFAULT_MODEL=gemini-3.8-flash
